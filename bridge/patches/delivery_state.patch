+test('submission acknowledgement rechecks the current DOM after root replacement and asynchronous Show more', async () => {
+  const { sandbox } = await bootstrapExtensionContentRuntime();
+  const timers = new Map();
+  let nextTimer = 0, turns = [], observedRoot = null, disconnected = false, expansions = 0;
+  sandbox.setTimeout = (callback, ms) => { const id = ++nextTimer; timers.set(id, { callback, ms }); return id; };
+  sandbox.clearTimeout = (id) => timers.delete(id);
+  sandbox.MutationObserver = class {
+    observe(root) { observedRoot = root; }
+    disconnect() { disconnected = true; }
+  };
+  const oldRoot = { isConnected: true };
+  sandbox.document.body = oldRoot;
+  sandbox.document.querySelectorAll = () => [];
+  const prompt = 'LONG-BEGIN\n' + 'literal input\n'.repeat(1500) + 'LONG-END';
+  const payload = { textContent: prompt.slice(0, 10240) };
+  const more = { disabled: false, getAttribute(name) { return name === 'aria-label' ? 'Show more' : null; },
+    click() { expansions++; } };
+  const bubble = { querySelectorAll(selector) {
+    return selector === '.whitespace-pre-wrap[dir="auto"]' ? [payload] : [more];
+  } };
+  const userTurn = { querySelector() { return bubble; } };
+  const commands = sandbox.ChatGptComposerCommands.createComposerCommands(composerDependencies({
+    getTurnNodes() { return turns; }, turnKey() { return 'new-own-user'; }, turnRole() { return 'user'; },
+  }));
+  const waiter = commands.createPromptSubmissionEvidenceWaiter({ requestId: 'root-replaced' }, new Set(), prompt,
+    null, 1000, { allowExpand: true, expandedTurnKeys: new Set() });
+  const result = waiter.wait();
+  assert.equal(observedRoot, oldRoot);
+  oldRoot.isConnected = false;
+  sandbox.document.body = { isConnected: true }; // No mutation reaches the old root.
+  turns = [userTurn];
+  const tick = () => {
+    const [id, timer] = [...timers].find(([, item]) => item.ms === 200);
+    timers.delete(id); timer.callback();
+  };
+  tick();
+  assert.equal(expansions, 1);
+  payload.textContent = prompt; // Show more's async render, also without an old-root mutation.
+  tick();
+  const evidence = await result;
+  assert.equal(evidence.confirmed, true);
+  assert.equal(evidence.turnKey, 'new-own-user');
+  assert.equal(expansions, 1, 'read-only reinspection never repeats expansion');
+  assert.equal(disconnected, true);
+  assert.equal(timers.size, 0, 'both timeout and reinspection are bounded and cleaned up');
+});
+
+test('submission timeout performs a final current-DOM inspection when polling was throttled', async () => {
+  const { sandbox } = await bootstrapExtensionContentRuntime();
+  const timers = new Map();
+  let nextTimer = 0, turns = [];
+  sandbox.setTimeout = (callback, ms) => { const id = ++nextTimer; timers.set(id, { callback, ms }); return id; };
+  sandbox.clearTimeout = (id) => timers.delete(id);
+  const commands = sandbox.ChatGptComposerCommands.createComposerCommands(composerDependencies({
+    getTurnNodes() { return turns; }, turnKey() { return 'late-own-user'; }, turnRole() { return 'user'; },
+  }));
+  const waiter = commands.createPromptSubmissionEvidenceWaiter({ requestId: 'late-user' }, new Set(), 'exact late text', null, 1000);
+  const result = waiter.wait();
+  turns = [{ textContent: 'exact late text' }];
+  const [, deadline] = [...timers].find(([, item]) => item.ms === 1000);
+  deadline.callback(); // The 200ms callback never ran.
+  assert.equal((await result).confirmed, true);
+  assert.equal(timers.size, 0);
+});
